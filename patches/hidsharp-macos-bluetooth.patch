+        internal static int ResolveService(string key)
+        {
+            if (key == null) { return 0; }
+            int sep = key.LastIndexOf("#HID=", StringComparison.Ordinal);
+            if (sep < 0) { return NativeMethods.IORegistryEntryCopyFromPath(0, key); }
+
+            // key: <path>#HID=<vid>:<pid>:<idx>  — class matching on IOHIDDevice covers all subclasses.
+            string[] parts = key.Substring(sep + 5).Split(':');
+            if (parts.Length != 3) { return 0; }
+            int wantVid, wantPid, wantIdx;
+            if (!int.TryParse(parts[0], out wantVid) || !int.TryParse(parts[1], out wantPid) || !int.TryParse(parts[2], out wantIdx)) { return 0; }
+
+            var matching = NativeMethods.IOServiceMatching("IOHIDDevice"); // consumed by IOServiceGetMatchingServices
+            int iteratorObj;
+            if (NativeMethods.IOReturn.Success == NativeMethods.IOServiceGetMatchingServices(0, matching, out iteratorObj))
+            {
+                using (var iterator = iteratorObj.ToIOObject())
+                {
+                    int seen = 0;
+                    while (true)
+                    {
+                        int entry = NativeMethods.IOIteratorNext(iterator);
+                        if (entry == 0) { break; }
+                        using (entry.ToIOObject())
+                        {
+                            int? vid = null, pid = null;
+                            try
+                            {
+                                vid = NativeMethods.IORegistryEntryGetCFProperty_Int(entry, NativeMethods.kIOHIDVendorIDKey);
+                                pid = NativeMethods.IORegistryEntryGetCFProperty_Int(entry, NativeMethods.kIOHIDProductIDKey);
+                            }
+                            catch { }
+                            if (vid != null && pid != null && vid == wantVid && pid == wantPid)
+                            {
+                                if (seen == wantIdx) { return entry; }
+                                seen++;
+                            }
+                        }
+                    }
+                }
+            }
+            return 0;
+        }
+
